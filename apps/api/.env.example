POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tourniquet
POSTGRES_PASSWORD=tourniquet
POSTGRES_DB=tourniquet
# Set true for Supabase / managed Postgres
POSTGRES_SSL=false
# Force IPv4 on hosts that cannot reach Supabase over IPv6 (e.g. Render free)
POSTGRES_FAMILY=

JWT_SECRET=change-me

# ──────────────────────────────────────
# Google OAuth
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example: https://tourniquet-api.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8090/auth/google/callback

# ──────────────────────────────────────
# Frontend (used for post-OAuth redirect + CORS)
# ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Optional comma-separated list; defaults to FRONTEND_URL
CORS_ORIGIN=http://localhost:3000

# Render / hosts inject PORT; local default is 8090
PORT=8090
